# =============================================================
# Travel Planner Microservices Environment Configuration
# =============================================================

# --- Environment ---
ENVIRONMENT=development

# --- LLM API Keys ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Gateway Service (Port 8000) ---
GATEWAY_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# --- Agent Service (Port 8001) ---
AGENT_SERVICE_PORT=8001
AGENT_SERVICE_URL=http://agent-service:8001

# --- DB Service (Port 8002) ---
DB_SERVICE_PORT=8002
DB_SERVICE_URL=http://db-service:8002
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=travel_planner

# --- Trip Service (Port 8003) ---
TRIP_SERVICE_PORT=8003
TRIP_SERVICE_URL=http://trip-service:8003
ENABLE_LIVE_SCRAPING=false
TRIP_COM_BASE_URL=https://www.trip.com
